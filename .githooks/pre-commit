#!/bin/sh

MAX_SIZE=52428800
FILES=$(git diff --cached --name-only --diff-filter=ACMR)

for file in $FILES; do
    case "$file" in
        Saved/*[Intermediate/*|Binaries/*|DerivedDataCache/*|.vs/*)
            echo "ERROR: Forbidden UES folder detected ($file). Commit aborted!"
            exit 1
            ;;
        esac

    if [ -f "$file" ]; then
        size=$(wc -c < "$file" | tr -d ' ')
        if ["$size" -gt "$MAX_SIZE" ]; then
            is_lfs=$(git check-attr filter -- "$file" | awk '{print $3}')
            if ["$is_lfs" != "lfs" ]; then
                echo "ERROR: File $file exceeds 50MB ($size bytes) and is not tracked by Git LFS!"
                exit 1
            fi
        fi
    fi
done
